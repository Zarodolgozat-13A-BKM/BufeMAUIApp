<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:BufeApp.Models"
             xmlns:services="clr-namespace:BufeApp.Services"
             x:Class="BufeApp.Pages.CartPage"
             Shell.NavBarIsVisible="False"
             Title="">

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}" Padding="0,16,0,0">

        <!-- Closed Message -->
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="32" 
                             IsVisible="{Binding IsBuffetClosed}" Spacing="24">
            <Grid HeightRequest="120" HorizontalOptions="Center">
                <Border Stroke="{StaticResource Primary}" StrokeThickness="2" Opacity="0.2"
        HeightRequest="110" WidthRequest="110"
        StrokeShape="RoundRectangle 55"
        HorizontalOptions="Center" VerticalOptions="Center"/>

                <Border BackgroundColor="#1AEE8C2B" StrokeThickness="0"
        HeightRequest="96" WidthRequest="96"
        StrokeShape="RoundRectangle 48"
        HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="warning" FontFamily="MaterialIcons" TextColor="{StaticResource Primary}" FontSize="52" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>
            <VerticalStackLayout Spacing="8">
                <Label Text="Kérjük, nézz vissza később!"
       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
       FontSize="32"
       FontAttributes="Bold"
       HorizontalTextAlignment="Center" />

                <Label Text="Sajnáljuk, a büfé jelenleg zárva tart, vagy mára már nincs több átvételi időpont."
       TextColor="{AppThemeBinding Light=#897561, Dark=#9CA3AF}"
       FontSize="16"
       HorizontalTextAlignment="Center"
       WidthRequest="320" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Main Scroll -->
        <ScrollView VerticalScrollBarVisibility="Never" IsVisible="{Binding IsBuffetOpen}">
            <VerticalStackLayout Spacing="0">

                <!-- Picker -->
                <VerticalStackLayout Padding="16,12" Spacing="0">
                    <Label Text="Mikorra legyen kész? " FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" Margin="0,0,0,16"/>
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Stroke="Transparent"
                            StrokeThickness="1" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout>
                            <!-- Header -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="56" Padding="16,0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTimePickerTapped" />
                                </Grid.GestureRecognizers>
                                <Label x:Name="SelectedTimeLabel" Text="Válassz időpontot..." 
                                       TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" 
                                       VerticalOptions="Center" FontSize="14" />
                                <Label x:Name="ChevronIcon" Grid.Column="1" 
                                       Text="expand_more" FontFamily="MaterialIcons"
                                       TextColor="{StaticResource Primary}" 
                                       VerticalOptions="Center" HorizontalOptions="Center" 
                                       FontSize="24" />
                            </Grid>

                            <!-- Options Container -->
                            <VerticalStackLayout x:Name="TimeOptionsContainer" IsVisible="False" Opacity="0" Padding="0,0,0,8">
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="16,0,16,8" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Breaks}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:Break">
                                            <Label Text="{Binding start, StringFormat='{}Átvétel {0}-tól'}" Padding="16,12" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTimeOptionSelected" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Info box -->
                <Border Margin="16,8,16,16" BackgroundColor="{AppThemeBinding Light=#1Aee8c2b, Dark=#1Aee8c2b}"
                        Stroke="{AppThemeBinding Light=#33ee8c2b, Dark=#33ee8c2b}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="storefront" FontFamily="MaterialIcons" TextColor="{StaticResource Primary}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Label Text="Átvétel az iskolai büfében." TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=#e5e7eb}" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Line -->
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="16,8" />

                <!-- Order Note -->
                <VerticalStackLayout Padding="16,8,16,8" Spacing="16">
                    <Label Text="Megjegyzés a rendeléshez" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
StrokeThickness="1" StrokeShape="RoundRectangle 12">
                        <Editor Placeholder="Ide írhatod, ha valami egyedi kérésed van..." 
    TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}"
    PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark=#71717a}"
    HeightRequest="80" Margin="12,8" BackgroundColor="Transparent" x:Name="Comment_Entry" />
                    </Border>
                </VerticalStackLayout>

                <!-- Order Summary -->
                <VerticalStackLayout Padding="16,16,16,8">
                    <Label Text="Rendelés összesítése" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" Margin="0,0,0,16"/>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Stroke="Transparent"
                            StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                        <VerticalStackLayout Spacing="16">

                            <!-- Empty Cart Message -->
                            <VerticalStackLayout IsVisible="{Binding IsCartEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                                <Label Text="Még üres a kosarad, tegyél hozzá valamit" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                            <!-- Items Collection -->
                            <CollectionView ItemsSource="{Binding Source={x:Static services:CartService.Items}}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CartItemModel">
                                        <Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,16">
                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="48" WidthRequest="48" BackgroundColor="{StaticResource Gray200}" VerticalOptions="Center">
                                                <Image Source="{Binding Item.PictureUrl}" Aspect="AspectFill" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Item.Name}" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14" FontAttributes="Bold" />
                                                <Label Text="{Binding Item.Price, StringFormat='{0} Ft'}" TextColor="{StaticResource Primary}" FontSize="12" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="0" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                                                <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                                                    <Button Text="-" WidthRequest="32" HeightRequest="32" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="16" Clicked="OnDecreaseQuantity" BindingContext="{Binding .}" />
                                                    <Label Text="{Binding Quantity}" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="20" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14" />
                                                    <Button Text="+" WidthRequest="32" HeightRequest="32" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="16" Clicked="OnIncreaseQuantity" BindingContext="{Binding .}" />
                                                </HorizontalStackLayout>
                                            </Border>
                                            <Grid Grid.Column="3" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" BindingContext="{Binding .}">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDeleteItem" CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <Label Text="delete" FontFamily="MaterialIcons" TextColor="{AppThemeBinding Light=#EF4444, Dark=#F87171}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,4" />

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto, Auto" RowSpacing="6">
                                <Label Grid.Row="1" Grid.Column="0" Text="Összesen" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="16" FontAttributes="Bold" VerticalOptions="End" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalPrice, StringFormat='{0} Ft'}" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="20" FontAttributes="Bold" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                

                <!-- Bottom Button Bar -->
                <VerticalStackLayout Spacing="12" Margin="16,16,16,16" Padding="0" IsVisible="{Binding IsCartNotEmpty}">
                    <Button Text="Fizetés Kártyával" Clicked="PayWithCard_Clicked"
            BackgroundColor="{StaticResource Primary}"
            TextColor="White"
            FontAttributes="Bold"
            FontSize="16"
            CornerRadius="12"
            HeightRequest="56">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Opacity="0.25" Radius="10" Offset="0,4"/>
                        </Button.Shadow>
                    </Button>

                    <Button Text="Fizetés Készpénzzel" Clicked="PayWithCash_Clicked"
            BackgroundColor="Transparent"
            BorderColor="{StaticResource Primary}"
            BorderWidth="2"
            TextColor="{StaticResource Primary}"
            FontAttributes="Bold"
            FontSize="16"
            CornerRadius="12"
            HeightRequest="56">
                    </Button>
                </VerticalStackLayout>

            </VerticalStackLayout>
            
        </ScrollView>
        
        

        
        

    </Grid>
</ContentPage>