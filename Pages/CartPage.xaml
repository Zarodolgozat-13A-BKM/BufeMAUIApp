            <x:String x:Key="IconStar">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</x:String>
            <x:String x:Key="IconDelete">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19Z</x:String>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}" Padding="0,16">
        <!-- Main Scroll -->
        <ScrollView Margin="0,0,0,80" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">

                <!-- Picker -->
                <VerticalStackLayout Padding="16,12" Spacing="0">
                    <Label Text="Mikorra legyen kész? " FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" Margin="0,0,0,16"/>
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Stroke="Transparent"
                            StrokeThickness="1" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout>
                            <!-- Header -->
                            <Grid ColumnDefinitions="*,Auto" HeightRequest="56" Padding="16,0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTimePickerTapped" />
                                </Grid.GestureRecognizers>
                                <Label x:Name="SelectedTimeLabel" Text="Válassz időpontot..." 
                                       TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" 
                                       VerticalOptions="Center" FontSize="14" />
                                <Path x:Name="ChevronIcon" Grid.Column="1" 
                                      Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z" 
                                      Fill="{StaticResource Primary}" 
                                      VerticalOptions="Center" HorizontalOptions="Center" 
                                      HeightRequest="24" WidthRequest="24" Aspect="Uniform" />
                            </Grid>

                            <!-- Options Container -->
                            <VerticalStackLayout x:Name="TimeOptionsContainer" IsVisible="False" Opacity="0" Padding="0,0,0,8">
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="16,0,16,8" />

                                <Label Text="Tízórai (10:30)" Padding="16,12" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTimeOptionSelected" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Text="Ebéd 1 (12:00)" Padding="16,12" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTimeOptionSelected" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Text="Ebéd 2 (13:00)" Padding="16,12" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTimeOptionSelected" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Info box -->
                <Border Margin="16,8,16,16" BackgroundColor="{AppThemeBinding Light=#1Aee8c2b, Dark=#1Aee8c2b}"
                        Stroke="{AppThemeBinding Light=#33ee8c2b, Dark=#33ee8c2b}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Path Data="{StaticResource IconStorefront}" Fill="{StaticResource Primary}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" />
                        <Label Text="Átvétel az iskolai büfében." TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=#e5e7eb}" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Line -->
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="16,8" />

                <!-- Order Note -->
                <VerticalStackLayout Padding="16,8,16,8" Spacing="8">
                    <Label Text="Megjegyzés a rendeléshez" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" />
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 12">
                        <Editor Placeholder="Ide írhatod, ha valami egyedi kérésed van..." 
                                TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark=#71717a}"
                                HeightRequest="80" Margin="12,8" BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- Order Summary -->
                <VerticalStackLayout Padding="16,16,16,8">
                    <Label Text="Rendelés összesítése" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" Margin="0,0,0,16"/>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Stroke="Transparent"
                            StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                        <VerticalStackLayout Spacing="16">
                            <!-- Items -->
                            <Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="12">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="48" WidthRequest="48" BackgroundColor="{StaticResource Gray200}" VerticalOptions="Center">
                                    <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuC2Fuf7R4tKyocOnxpigoSDDWGzT60H4zuh_45_steq-_o4lf2MEaSENC0rL-IqkxYB5Ncit-0R3XdCMLxj6ulroT-4BlgP6BHPA-e1GWLPCgO45tCPm8rSld5G1iAndrrekJYfyCLNouqEfIdKrhzoEUB1kNfM1ku3e2k1Jw8gvQGup05AVZr3zlxr5lF0s3jIgnu0bhkC4eJLnOwNdqSpdep65ngjYOz8fdn8tQWW3FJgSc0PNeDOQ3-hR30kodmXBszml9iNnDdh" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Klasszikus Burger" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="2 400 Ft" TextColor="{StaticResource Primary}" FontSize="12" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="0" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                                    <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                                        <Button Text="-" WidthRequest="32" HeightRequest="32" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="16" />
                                        <Label Text="1" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="20" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14" />
                                        <Button Text="+" WidthRequest="32" HeightRequest="32" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="16" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Grid Grid.Column="3" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                    <Path Data="{StaticResource IconDelete}" Fill="{AppThemeBinding Light=#EF4444, Dark=#F87171}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                            
                            <Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="12">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="48" WidthRequest="48" BackgroundColor="{StaticResource Gray200}" VerticalOptions="Center">
                                    <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuDvYGXLz-qgr08wYyMMBtVc8Ivfbwjg9X50oVsLye4fGksUvU9gGTmgZwZ_HVeXNFviGRuJEmawUXuQCnLlZA5ZqpBUuDkmWV2fMybEKC1-a53Y-L5xPWGD38PRRhOEbCqa5MY2e8XfQA1iOK7sWgIrFBrjdxOa31-Vvi6KtR9z_DunlV8hrm0jZdQMCoq-IG5XI66rXFLrprfe77PjbfXpgXchm-JS_eQ2Ngktwe-DPseidDeqCf9TqtF8HJKufrdjUhMlDLnmd0sv" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Csokis Keksz" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="1 200 Ft" TextColor="{StaticResource Primary}" FontSize="12" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="0" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                                    <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                                        <Button Text="-" WidthRequest="32" HeightRequest="32" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="16" />
                                        <Label Text="2" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="20" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14" />
                                        <Button Text="+" WidthRequest="32" HeightRequest="32" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="16" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Grid Grid.Column="3" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                    <Path Data="{StaticResource IconDelete}" Fill="{AppThemeBinding Light=#EF4444, Dark=#F87171}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                            
                            <Grid ColumnDefinitions="48,*,Auto,Auto" ColumnSpacing="12">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="48" WidthRequest="48" BackgroundColor="{StaticResource Gray200}" VerticalOptions="Center">
                                    <Image Source="https://lh3.googleusercontent.com/aida-public/AB6AXuCpPTF6rc8rFmnBD046xcyoaUI4mulQUDeF0JJqc2HNWQCXuMfL-kRCG4UzVBTcKbOe-LUwH5R2jayWzrVXuOqFPpK-RbxG0qGYom80R5rlMjgebHgM12w21z-N8fmKaI6Hb9YzqDz5RQ1gGzBV8UO2Ktkk2gBfE0kRegIHhvkneTr06S_NtaRmU6mSvZE4iHj3RCn8xmy1FyaqYMhJiwX4fveRrnk1Jf5sQTJy2ws805tHuBnHFBIlZak-rqGuiwxJCXyG8v2p3bKa" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Narancslé" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="800 Ft" TextColor="{StaticResource Primary}" FontSize="12" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="0" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                                    <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                                        <Button Text="-" WidthRequest="32" HeightRequest="32" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="16" />
                                        <Label Text="1" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="20" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="14" />
                                        <Button Text="+" WidthRequest="32" HeightRequest="32" Padding="0" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="16" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Grid Grid.Column="3" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                    <Path Data="{StaticResource IconDelete}" Fill="{AppThemeBinding Light=#EF4444, Dark=#F87171}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" Margin="0,4" />

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto, Auto" RowSpacing="6">

                                <Label Grid.Row="1" Grid.Column="0" Text="Összesen" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="16" FontAttributes="Bold" VerticalOptions="End" />
                                <Label Grid.Row="1" Grid.Column="1" Text="4 400 Ft" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontSize="20" FontAttributes="Bold" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Loyalty Points info -->
                <Border Margin="16,8,16,24" BackgroundColor="{AppThemeBinding Light=#FEFCE8, Dark=#33451A03}"
                        Stroke="{AppThemeBinding Light=#FEF08A, Dark=#66451A03}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 20" Padding="16,8" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Path Data="{StaticResource IconStar}" Fill="{AppThemeBinding Light=#F59E0B, Dark=#FBBF24}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" />
                        <Label Text="+12 PONTOT KAPSZ!" TextColor="{AppThemeBinding Light=#B45309, Dark=#FBBF24}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Button Bar -->
        <Button Text="Rendelés"
    BackgroundColor="{StaticResource Primary}"
    TextColor="White"
    FontAttributes="Bold"
    FontSize="16"
    CornerRadius="12"
    HeightRequest="56"
    VerticalOptions="End"
    Margin="20">
            <Button.Shadow>
                <Shadow Brush="{StaticResource Primary}" Opacity="0.25" Radius="10" Offset="0,4"/>
            </Button.Shadow>
        </Button>

    </Grid>
</ContentPage>