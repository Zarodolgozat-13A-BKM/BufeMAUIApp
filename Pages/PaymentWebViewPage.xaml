<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BufeApp.Pages.PaymentWebViewPage"
             Title="PaymentWebViewPage">
    <Grid RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}">

        <ActivityIndicator x:Name="Loader"
                           Grid.Row="0"
                           IsRunning="True"
                           IsVisible="True"
                           Color="{StaticResource Primary}"
                           Margin="0,32,0,0"
                           HorizontalOptions="Center"/>

        <WebView x:Name="StripeWebView"
                 Grid.Row="1"
                 Navigating="OnNavigating"
                 Navigated="OnNavigated"/>
    </Grid>
</ContentPage>