<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BufeApp.Pages.LoginPage"
             Shell.NavBarIsVisible="False"
             Title="LoginPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <x:String x:Key="IconRestaurant">M11,9H9V2H7V9H5V2H3V9C3,11.12 4.66,12.84 6.75,12.97V22H9.25V12.97C11.34,12.84 13,11.12 13,9V2H11V9M16,6V14H18.5V22H21V2C18.24,2 16,4.24 16,6Z</x:String>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid IgnoreSafeArea="True">

        <BoxView Color="{AppThemeBinding Light=#E6f8f7f6, Dark={StaticResource BgDark}}" />

        <ScrollView>
            <VerticalStackLayout Spacing="0" 
                             Padding="24,60,24,24" 
                             VerticalOptions="Center">

                <VerticalStackLayout HorizontalOptions="Center" Spacing="24" Margin="0,0,0,30">
                    <Grid HeightRequest="120" HorizontalOptions="Center">
                        <Border Stroke="{StaticResource Primary}" StrokeThickness="2" Opacity="0.2"
                            HeightRequest="110" WidthRequest="110"
                            StrokeShape="RoundRectangle 55"
                            HorizontalOptions="Center" VerticalOptions="Center"/>

                        <Border BackgroundColor="#1AEE8C2B" StrokeThickness="0"
                            HeightRequest="96" WidthRequest="96"
                            StrokeShape="RoundRectangle 48"
                            HorizontalOptions="Center" VerticalOptions="Center">
                            <Path Data="{StaticResource IconRestaurant}" 
                                Fill="{StaticResource Primary}"
                                Aspect="Uniform"
                                HeightRequest="52" WidthRequest="52"
                                HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Jedlik Büfé"
                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                           FontSize="32"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />

                        <Label Text="Rendelj bármit a büféből hogy szünetbe ne kelljen kiállni a sort, vagy akár a teremben élvezhesd"
                           TextColor="{AppThemeBinding Light=#897561, Dark=#9CA3AF}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           WidthRequest="280" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="20">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Iskolai E-mail" 
                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark=#E5E7EB}"
                           FontSize="14" 
                           FontAttributes="Bold"/>

                        <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            HeightRequest="56">
                            <Grid ColumnDefinitions="*" Padding="16,0">
                                <Entry Grid.Column="0"
                                   x:Name="Email_Entry"
                                   Placeholder="nev@jedlik.eu"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                   FontSize="16"
                                   VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Iskolai Jelszó" 
                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark=#E5E7EB}"
                           FontSize="14" 
                           FontAttributes="Bold"/>

                        <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            HeightRequest="56">
                            <Grid ColumnDefinitions="*" Padding="16,0">
                                <Entry Grid.Column="0"
                                   x:Name="Password_Entry"
                                   IsPassword="True"
                                   Placeholder="Írd be a jelszavad"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                                   FontSize="16"
                                   VerticalOptions="Center"/>


                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="Auto, *" Margin="0,4,0,0">

                            <Label Grid.Column="1" 
                               Text="Elfelejtetted a jelszavad?" 
                               FontSize="12" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="End"
                               VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>

                    <Button Text="Bejelentkezés"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="56"
                        Margin="0,10,0,0"
                        Clicked="LoginButton_Clicked">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Opacity="0.25" Radius="10" Offset="0,4"/>
                        </Button.Shadow>
                    </Button>


                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>