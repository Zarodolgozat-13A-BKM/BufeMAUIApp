<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BufeApp.Pages.OrderStatusPage"
             Title="OrderStatusPage">
    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
        <Label Text="✅" FontSize="64" HorizontalOptions="Center"/>
        <Label Text="{Binding OrderTitle}"
               FontSize="22" FontAttributes="Bold"
               HorizontalOptions="Center"/>
        <Label Text="Rendelésed leadva! Hamarosan értesítünk."
               FontSize="15" TextColor="#666"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"/>
    </VerticalStackLayout>
</ContentPage>