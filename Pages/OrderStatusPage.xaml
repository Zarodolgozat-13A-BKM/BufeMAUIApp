<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:BufeApp.Pages"
             x:Class="BufeApp.Pages.OrderStatusPage"
             x:DataType="pages:OrderStatusViewModel"
             Title=""
             BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="True" IsEnabled="True"/>
    </Shell.BackButtonBehavior>

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}"
          RowDefinitions="*,Auto">

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">

                <!-- ═══ SUCCESS HEADER ═══ -->
                <VerticalStackLayout Padding="16,24,16,16" Spacing="8" HorizontalOptions="Center">

                    <Grid HeightRequest="96" WidthRequest="96" HorizontalOptions="Center">
                        <Border Stroke="{StaticResource Primary}" StrokeThickness="2" Opacity="0.2"
                                HeightRequest="96" WidthRequest="96"
                                StrokeShape="RoundRectangle 48"
                                HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border BackgroundColor="#1Aee8c2b" StrokeThickness="0"
                                HeightRequest="80" WidthRequest="80"
                                StrokeShape="RoundRectangle 40"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <!-- Checkmark path -->
                            <Path Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z"
                                  Fill="{StaticResource Primary}"
                                  Aspect="Uniform"
                                  HeightRequest="36" WidthRequest="36"
                                  HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <Label Text="Sikeres rendelés!"
                           FontSize="26" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource White}}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="A konyha megkapta a rendelésedet."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#897561, Dark=#9CA3AF}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="{Binding OrderTitle}"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- ═══ 4-STEP STEPPER ═══ -->
                <Border Margin="16,0,16,16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="Transparent"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16,20,16,16">
                    <Grid RowDefinitions="Auto,Auto,Auto">

                        <!-- Step circles -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*">

                            <!-- Background connector line -->
                            <BoxView Grid.ColumnSpan="4"
                                     HeightRequest="2"
                                     VerticalOptions="Center"
                                     Margin="26,0"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"/>

                            <!-- Step 1: Fizetésre vár -->
                            <Border Grid.Column="0"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Center"
                                    BackgroundColor="{Binding Step1Background}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <!-- Payment icon -->
                                <Path Data="M20,4H4C2.89,4 2,4.89 2,6V18C2,19.11 2.89,20 4,20H20C21.11,20 22,19.11 22,18V6C22,4.89 21.11,4 20,4M20,18H4V12H20V18M20,8H4V6H20V8Z"
                                      Fill="{Binding Step1IconColor}"
                                      Aspect="Uniform"
                                      HeightRequest="18" WidthRequest="18"
                                      HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <!-- Step 2: Fizetve -->
                            <Border Grid.Column="1"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Center"
                                    BackgroundColor="{Binding Step2Background}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <!-- Check circle icon -->
                                <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z"
                                      Fill="{Binding Step2IconColor}"
                                      Aspect="Uniform"
                                      HeightRequest="18" WidthRequest="18"
                                      HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <!-- Step 3: Készítjük -->
                            <Border Grid.Column="2"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Center"
                                    BackgroundColor="{Binding Step3Background}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <!-- Restaurant icon -->
                                <Path Data="M18.06,22.99H11.03C10.11,23.0 9.3,22.41 9.07,21.52L6.54,11.78C5.9,11.91 5.44,12.5 5.44,13.16V19.22C5.44,19.77 5.0,20.22 4.44,20.22H3C2.44,20.22 2,19.77 2,19.22V13.16A4.53,4.53 0 0,1 6.47,8.63L11.65,7.58C12.16,7.47 12.68,7.58 13.1,7.87L17.36,10.67C17.77,10.95 18.06,11.39 18.16,11.89L19.6,20.92C19.69,21.47 19.57,22.04 19.25,22.5C19.0,22.83 18.54,23.01 18.06,22.99M21.03,1.54H19.09C18.24,1.54 17.55,2.23 17.55,3.08V10.5L18.55,10.5L20.5,3.83L21.03,3.83V1.54Z"
                                      Fill="{Binding Step3IconColor}"
                                      Aspect="Uniform"
                                      HeightRequest="18" WidthRequest="18"
                                      HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <!-- Step 4: Átvehető -->
                            <Border Grid.Column="3"
                                    WidthRequest="36" HeightRequest="36"
                                    HorizontalOptions="Center"
                                    BackgroundColor="{Binding Step4Background}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <!-- Shopping bag icon -->
                                <Path Data="M19,6H17C17,3.24 14.76,1 12,1C9.24,1 7,3.24 7,6H5C3.9,6 3,6.9 3,8V20C3,21.1 3.9,22 5,22H19C20.1,22 21,21.1 21,20V8C21,6.9 20.1,6 19,6M12,3C13.66,3 15,4.34 15,6H9C9,4.34 10.34,3 12,3M19,20H5V8H19V20M12,17C10.34,17 9,15.66 9,14C9,12.34 10.34,11 12,11C13.66,11 15,12.34 15,14C15,15.66 13.66,17 12,17Z"
                                      Fill="{Binding Step4IconColor}"
                                      Aspect="Uniform"
                                      HeightRequest="18" WidthRequest="18"
                                      HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <!-- Step labels -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="0,10,0,0">
                            <Label Grid.Column="0"
                                   Text="Fizetésre&#x0a;vár"
                                   FontSize="10" FontAttributes="Bold"
                                   TextColor="{Binding Step1LabelColor}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="1"
                                   Text="Fizetve"
                                   FontSize="10" FontAttributes="Bold"
                                   TextColor="{Binding Step2LabelColor}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="2"
                                   Text="Készítjük"
                                   FontSize="10" FontAttributes="Bold"
                                   TextColor="{Binding Step3LabelColor}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="3"
                                   Text="Átvehető"
                                   FontSize="10" FontAttributes="Bold"
                                   TextColor="{Binding Step4LabelColor}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </Grid>

                        <!-- WS debug indicator -->
                        <VerticalStackLayout Grid.Row="2" Margin="0,14,0,0" Spacing="4">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                <Ellipse WidthRequest="8" HeightRequest="8"
                                         VerticalOptions="Center"
                                         Fill="{Binding WsStatusColor}"/>
                                <Label Text="WebSocket"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{Binding WsStatusColor}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Label Text="{Binding WsStatusText}"
                                   FontSize="10"
                                   TextColor="{AppThemeBinding Light=#897561, Dark=#9CA3AF}"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"
                                   MaxLines="12"/>
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!-- ═══ DELIVERY DATE ═══ -->
                <Border Margin="16,0,16,16"
                        BackgroundColor="#1Aee8c2b"
                        Stroke="#33ee8c2b"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="12">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <!-- Clock icon -->
                        <Path Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M16.24,16.24L11,13V7H12.5V12.2L17,14.9L16.24,16.24Z"
                              Fill="{StaticResource Primary}"
                              Aspect="Uniform"
                              HeightRequest="22" WidthRequest="22"
                              VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="SZÁLLÍTÁS NAPJA"
                                   FontSize="10" FontAttributes="Bold"
                                   CharacterSpacing="1.2"
                                   TextColor="{StaticResource Primary}"/>
                            <Label Text="{Binding DeliveryDateLabel}"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource White}}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- ═══ ORDER SUMMARY ═══ -->
                <VerticalStackLayout Padding="16,0,16,8">
                    <Label Text="Rendelés összesítése"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource White}}"
                           Margin="0,0,0,16"/>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Stroke="Transparent"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
                        <VerticalStackLayout Spacing="0">

                            <CollectionView ItemsSource="{Binding OrderItems}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="pages:OrderItemDisplayModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="12"
                                              Margin="0,0,0,16">
                                            <Label Grid.Column="0"
                                                   Text="{Binding QuantityLabel}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource White}}"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="2"
                                                   Text="{Binding PriceLabel}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource White}}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                     Margin="0,4"/>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                <Label Grid.Column="0" Text="Összesen"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource White}}"
                                       VerticalOptions="End"/>
                                <Label Grid.Column="1"
                                       Text="{Binding TotalLabel}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource White}}"/>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══ BOTTOM BUTTON ═══ -->
        <VerticalStackLayout Grid.Row="1" Spacing="0" Margin="16,16,16,16">
            <Button Text="Vissza a főoldalra"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="56"
                    Command="{Binding GoHomeCommand}">
                <Button.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Opacity="0.25" Radius="10" Offset="0,4"/>
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
