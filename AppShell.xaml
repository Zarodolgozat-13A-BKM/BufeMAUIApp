<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BufeApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BufeApp"
    xmlns:pages="clr-namespace:BufeApp.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="BufeApp">

    <!-- Login page outside of TabBar -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="LoginPage"
        Shell.TabBarIsVisible="False" />

    <!-- TabBar for main navigation -->
    <TabBar Route="MainTabs">
        <ShellContent
            Title="Home"
            Icon="home.svg"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Cart"
            Icon="cart.svg"
            ContentTemplate="{DataTemplate pages:CartPage}"
            Route="CartPage" />

        <ShellContent
            Title="Loyalty"
            Icon="star.svg"
            ContentTemplate="{DataTemplate pages:LoyaltyPage}"
            Route="LoyaltyPage" />
    </TabBar>

</Shell>
