<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BufeApp.Controls.AnimatedSvgIcon">

    <Grid HeightRequest="120" HorizontalOptions="Center">
        <Border Stroke="{StaticResource Primary}" StrokeThickness="2" Opacity="0.2"
            HeightRequest="110" WidthRequest="110"
            StrokeShape="RoundRectangle 55"
            HorizontalOptions="Center" VerticalOptions="Center"/>

        <Border BackgroundColor="#1AEE8C2B" StrokeThickness="0"
            HeightRequest="96" WidthRequest="96"
            StrokeShape="RoundRectangle 48"
            HorizontalOptions="Center" VerticalOptions="Center">
            <Grid>
                <Path x:Name="ActivePath"
                    Fill="{StaticResource Primary}"
                    Aspect="Uniform"
                    HeightRequest="48" WidthRequest="48"
                    HorizontalOptions="Center" VerticalOptions="Center"/>
                <Path x:Name="HiddenPath"
                    Fill="{StaticResource Primary}"
                    Aspect="Uniform"
                    HeightRequest="52" WidthRequest="52"
                    HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

        </Border>
    </Grid>
</ContentView>
