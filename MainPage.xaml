<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BufeApp.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <x:String x:Key="IconArrow">M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z</x:String>
            <x:String x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</x:String>
            <x:String x:Key="IconAdd">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</x:String>
            <x:String x:Key="IconEco">M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z</x:String>

            <!-- Border colors -->
            <Color x:Key="BorderLight">#E5E7EB</Color>
            <Color x:Key="BorderDark">#374151</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}">

        <ScrollView VerticalScrollBarVisibility="Never" Padding="0,0,0,90">
            <VerticalStackLayout Spacing="0">

                <Grid ColumnDefinitions="Auto, *" Padding="20,16,20,10">
                    <HorizontalStackLayout Spacing="12">
                        <Grid HeightRequest="44" WidthRequest="44">
                            <Border Stroke="{AppThemeBinding Light=White, Dark={StaticResource BorderDark}}" StrokeThickness="2"
                                StrokeShape="RoundRectangle 22" HeightRequest="40" WidthRequest="40" VerticalOptions="Start" HorizontalOptions="Start">
                                <Image Source="profile.png" Aspect="AspectFill" />
                            </Border>
                            <Border BackgroundColor="#22c55e" Stroke="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}" 
                                StrokeThickness="2" StrokeShape="RoundRectangle 6"
                                HeightRequest="12" WidthRequest="12" HorizontalOptions="End" VerticalOptions="End" TranslationX="-4" TranslationY="-4"/>
                        </Grid>

                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Good Morning," FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}" FontAttributes="Bold"/>
                            <Label Text="Alex Johnson" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Grid>

                <Border Margin="20,10" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" HeightRequest="50">
                    <Grid ColumnDefinitions="50, *">
                        <Path Grid.Column="0" Data="{StaticResource IconSearch}" WidthRequest="24" Fill="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}" 
                          Aspect="Uniform" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" Placeholder="Craving a burger? Search menu..." 
                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}"
                           TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"
                           VerticalOptions="Center" BackgroundColor="Transparent" />
                    </Grid>
                </Border>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="20,20,20,0">
                    <HorizontalStackLayout Spacing="12">
                        <Button Text="🔥 Specials" BackgroundColor="{StaticResource Primary}" TextColor="White" 
                            CornerRadius="20" HeightRequest="40" Padding="16,0" FontAttributes="Bold" />
                        <Button Text="🍔 Mains" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" 
                            TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" 
                            CornerRadius="20" HeightRequest="40" Padding="16,0" FontAttributes="Bold"
                            BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}" BorderWidth="1"/>
                        <Button Text="🥗 Salads" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" 
                            TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" 
                            CornerRadius="20" HeightRequest="40" Padding="16,0" FontAttributes="Bold"
                            BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}" BorderWidth="1"/>
                        <Button Text="🥤 Drinks" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" 
                            TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" 
                            CornerRadius="20" HeightRequest="40" Padding="16,0" FontAttributes="Bold"
                            BorderColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}" BorderWidth="1"/>
                    </HorizontalStackLayout>
                </ScrollView>

                <Grid ColumnDefinitions="*, Auto" Padding="20,12,20,12">
                    <Label Text="Daily Specials" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"/>
                    <Label Grid.Column="1" Text="See All" TextColor="{StaticResource Primary}" FontAttributes="Bold" VerticalOptions="Center"/>
                </Grid>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="20,0,20,20">
                    <HorizontalStackLayout Spacing="16">

                        <Border WidthRequest="260" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout>
                                <Grid HeightRequest="150">
                                    <Image Source="special_wrap.png" Aspect="AspectFill" />
                                    <Border BackgroundColor="#E6FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 8" 
                                        HorizontalOptions="Start" VerticalOptions="Start" Margin="12" Padding="8,4">
                                        <Label Text="450 cal" TextColor="{StaticResource Primary}" FontSize="12" FontAttributes="Bold"/>
                                    </Border>
                                </Grid>
                                <VerticalStackLayout Padding="16" Spacing="8">
                                    <Label Text="Spicy Chicken Wrap" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"/>
                                    <Label Text="Whole wheat tortilla, grilled chicken" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}"/>
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,8,0,0">
                                        <Label Text="$5.50" TextColor="{StaticResource Primary}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 18" HeightRequest="36" WidthRequest="36">
                                            <Path Data="{StaticResource IconAdd}" Fill="White" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border WidthRequest="260" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout>
                                <Grid HeightRequest="150">
                                    <Image Source="special_pizza.png" Aspect="AspectFill" />
                                    <Border BackgroundColor="#E6FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 8" 
                                        HorizontalOptions="Start" VerticalOptions="Start" Margin="12" Padding="8,4">
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Path Data="{StaticResource IconEco}" Fill="#16a34a" Aspect="Uniform" HeightRequest="14" VerticalOptions="Center"/>
                                            <Label Text="Veggie" TextColor="#15803d" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                                <VerticalStackLayout Padding="16" Spacing="8">
                                    <Label Text="Veggie Pizza Slice" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"/>
                                    <Label Text="Peppers, onions, mozzarella" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}"/>
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,8,0,0">
                                        <Label Text="$4.00" TextColor="{StaticResource Primary}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 18" HeightRequest="36" WidthRequest="36">
                                            <Path Data="{StaticResource IconAdd}" Fill="White" Aspect="Uniform" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                    </HorizontalStackLayout>
                </ScrollView>

                <VerticalStackLayout Padding="20,10" Spacing="16">
                    <Label Text="Snacks &amp; Drinks" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"/>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                        <Grid ColumnDefinitions="96, *" ColumnSpacing="16">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 8" StrokeThickness="0" HeightRequest="96" WidthRequest="96">
                                <Image Source="fruit_cup.png" Aspect="AspectFill"/>
                            </Border>
                            <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
                                <Label Grid.Row="0" Text="Seasonal Fruit Cup" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"/>
                                <Label Grid.Row="1" Text="Fresh melon, grapes, and seasonal berries." FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}" LineBreakMode="TailTruncation" MaxLines="2" VerticalOptions="Start" Margin="0,4,0,0"/>

                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto" VerticalOptions="End">
                                    <Label Text="$3.00" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}" VerticalOptions="Center"/>
                                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark=#3a2f26}" StrokeThickness="0" StrokeShape="RoundRectangle 8" HeightRequest="32">
                                        <HorizontalStackLayout Spacing="0">
                                            <Button Text="-" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" FontAttributes="Bold" WidthRequest="36"/>
                                            <Label Text="1" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark=White}" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="20" HorizontalTextAlignment="Center"/>
                                            <Button Text="+" TextColor="{StaticResource Primary}" BackgroundColor="Transparent" FontAttributes="Bold" WidthRequest="36"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                        <Grid ColumnDefinitions="96, *" ColumnSpacing="16">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 8" StrokeThickness="0" HeightRequest="96" WidthRequest="96">
                                <Image Source="muffin.png" Aspect="AspectFill"/>
                            </Border>
                            <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
                                <Label Grid.Row="0" Text="Choco Muffin" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"/>

                                <Border Grid.Row="1" BackgroundColor="#fef3c7" StrokeThickness="0" StrokeShape="RoundRectangle 4" HorizontalOptions="Start" VerticalOptions="Start" Margin="0,4,0,0" Padding="6,2">
                                    <Label Text="Contains Nuts" TextColor="#854d0e" FontSize="10" FontAttributes="Bold"/>
                                </Border>

                                <Grid Grid.Row="2" ColumnDefinitions="*, Auto" VerticalOptions="End">
                                    <Label Text="$2.50" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}" VerticalOptions="Center"/>
                                    <Button Grid.Column="1" Text="Add" TextColor="{StaticResource Primary}" BackgroundColor="#1Aee8c2b" FontAttributes="Bold" CornerRadius="8" HeightRequest="32" Padding="16,0"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border VerticalOptions="End" Stroke="Transparent" BackgroundColor="Transparent" Padding="16">

            <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="56" Padding="20,0">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Border BackgroundColor="#33FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                            <Label Text="2" TextColor="White" FontAttributes="Bold" FontSize="14"/>
                        </Border>
                        <Label Text="Items in cart" TextColor="White" VerticalOptions="Center" FontSize="14" Opacity="0.9"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="2" Spacing="12" VerticalOptions="Center">
                        <Label Text="$5.50" TextColor="White" FontAttributes="Bold" FontSize="18" VerticalOptions="Center"/>

                    </HorizontalStackLayout>
                    <Path Data="{StaticResource IconArrow}" Grid.Column="3" Margin="16,0,0,0"
                      Fill="White"
                      Aspect="Uniform" 
                      HeightRequest="20"
                      WidthRequest="20"
                      VerticalOptions="Center" 
                      HorizontalOptions="Center"/>
                </Grid>
            </Border>
        </Border>

    </Grid>

</ContentPage>
