<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:BufeApp.Models"
             xmlns:converters="clr-namespace:BufeApp.Converters"
             xmlns:bottomsheet="http://pluginmauibottomsheet.com"
             x:Class="BufeApp.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Border colors -->
            <Color x:Key="BorderLight">#E5E7EB</Color>
            <Color x:Key="BorderDark">#374151</Color>

            <!-- Converters for category selection -->
            <converters:BoolToColorConverter x:Key="SelectedBgConverter" 
                TrueColor="{StaticResource Primary}" 
                FalseColorLight="{StaticResource SurfaceLight}" 
                FalseColorDark="{StaticResource SurfaceDark}" />
            <converters:BoolToColorConverter x:Key="SelectedTextConverter" 
                TrueColor="White" 
                FalseColorLight="{StaticResource TextMainLight}" 
                FalseColorDark="White" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}">

        <ScrollView x:Name="MainScrollView" VerticalScrollBarVisibility="Never" Padding="0,0,0,90"
                    Scrolled="OnMainScrollViewScrolled">
            <VerticalStackLayout Spacing="0">

                <!-- Header with profile -->
                <Grid ColumnDefinitions="Auto, *" Padding="20,16,20,10">
                    <HorizontalStackLayout Spacing="12">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Grid HeightRequest="50" HorizontalOptions="Center">
    <Border Stroke="{StaticResource Primary}" StrokeThickness="2" Opacity="0.2"
        HeightRequest="44" WidthRequest="44"
        StrokeShape="RoundRectangle 55"
        HorizontalOptions="Center" VerticalOptions="Center"/>

    <Border BackgroundColor="#1AEE8C2B" StrokeThickness="0"
        HeightRequest="36" WidthRequest="36"
        StrokeShape="RoundRectangle 32"
        HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="person" FontFamily="MaterialIcons" TextColor="{StaticResource Primary}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
    </Border>
</Grid>

                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Szia," FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}" FontAttributes="Bold"/>
                            <Label Text="{Binding Username}" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Search bar -->
                <Border Margin="20,10" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" HeightRequest="50">
                    <Grid ColumnDefinitions="50, *">
                        <Label Grid.Column="0" Text="search" FontFamily="MaterialIcons" TextColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}" 
                          FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" Placeholder="Keresés..." 
                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}"
                           TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"
                           Text="{Binding SearchQuery}"
                           VerticalOptions="Center" BackgroundColor="Transparent" />
                    </Grid>
                </Border>

                <!-- Category Bar (inline, will scroll with content) -->
                <Border x:Name="CategoryBarContainer"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}"
                        Stroke="Transparent" StrokeThickness="0" Padding="0,8" ZIndex="100">
                    <ScrollView x:Name="CategoryBarScrollView" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="20,0">
                        <HorizontalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Categories}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CategorieResponseModel">
                                    <Border StrokeShape="RoundRectangle 20" HeightRequest="40" Padding="16,0"
                                            StrokeThickness="1"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource SelectedBgConverter}}"
                                            Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Name}" 
                                               TextColor="{Binding IsSelected, Converter={StaticResource SelectedTextConverter}}"
                                               HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </Border>

                <!-- Featured Items Header -->
                <Grid ColumnDefinitions="*, Auto" Padding="20,12,20,12">
                    <Label Text="Kiemelt Ajánlatok" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"/>
                </Grid>

                <!-- Featured Items (Horizontal Scroll) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="20,0,20,20">
                    <HorizontalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding FeaturedItems}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ItemModel">
                                <Border WidthRequest="260" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout>
                                        <Grid HeightRequest="150">
                                            <Image Source="{Binding PictureUrl}" Aspect="AspectFill" />
                                        </Grid>
                                        <VerticalStackLayout Padding="16" Spacing="8">
                                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}" LineBreakMode="TailTruncation" MaxLines="1"/>
                                            <Label Text="{Binding Description}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}" LineBreakMode="TailTruncation" MaxLines="2"/>
                                            <Grid ColumnDefinitions="*, Auto" Margin="0,8,0,0">
                                                <Label Text="{Binding Price, StringFormat='{0} Ft'}" TextColor="{StaticResource Primary}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/>
                                                <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 18" HeightRequest="36" WidthRequest="36">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectItemCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="add" FontFamily="MaterialIcons" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- All Categories with their Items -->
                <VerticalStackLayout x:Name="CategorySectionsContainer" Spacing="0" BindableLayout.ItemsSource="{Binding Categories}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:CategorieResponseModel">
                            <VerticalStackLayout Padding="20,10" Spacing="12">
                                <!-- Category Header -->
                                <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"
                                       Margin="0,10,0,5"/>
                                
                                <!-- Items in this category -->
                                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ItemModel">
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                                <Grid ColumnDefinitions="96, *" ColumnSpacing="16">
                                                    <Grid Grid.Column="0" HeightRequest="96" WidthRequest="96">
                                                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                                            <Image Source="{Binding PictureUrl}" Aspect="AspectFill"/>
                                                        </Border>
                                                        <Border IsVisible="{Binding IsFeatured}" BackgroundColor="#E6FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 8" 
                                                            HorizontalOptions="Start" VerticalOptions="Start" Margin="4" Padding="6,2">
                                                            <Label Text="⭐ Kiemelt" TextColor="{StaticResource Primary}" FontSize="10" FontAttributes="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
                                                        <Label Grid.Row="0" Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}" LineBreakMode="TailTruncation" MaxLines="1"/>
                                                        <Label Grid.Row="1" Text="{Binding Description}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}" LineBreakMode="TailTruncation" MaxLines="2" VerticalOptions="Start" Margin="0,4,0,0"/>

                                                        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" VerticalOptions="End">
                                                            <Label Text="{Binding Price, StringFormat='{0} Ft'}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}" VerticalOptions="Center"/>
                                                            <Button Grid.Column="1" Text="Hozzáadás" TextColor="{StaticResource Primary}" BackgroundColor="#1Aee8c2b" FontAttributes="Bold" CornerRadius="8" HeightRequest="32" Padding="16,0"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectItemCommand}"
                                                                    CommandParameter="{Binding .}"/>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky Category Bar (shown when scrolled past threshold) -->
        <Border x:Name="StickyCategoryBar" 
                VerticalOptions="Start" 
                BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}"
                Stroke="Transparent" StrokeThickness="0" Padding="0,8" 
                IsVisible="False"
                ZIndex="200">
            <ScrollView x:Name="StickyCategoryBarScrollView" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="20,0">
                <HorizontalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Categories}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:CategorieResponseModel">
                            <Border StrokeShape="RoundRectangle 20" HeightRequest="40" Padding="16,0"
                                    StrokeThickness="1"
                                    BackgroundColor="{Binding IsSelected, Converter={StaticResource SelectedBgConverter}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark=Transparent}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Name}" 
                                       TextColor="{Binding IsSelected, Converter={StaticResource SelectedTextConverter}}"
                                       HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </Border>

        <!-- Cart Bar -->
        <Border VerticalOptions="End" Stroke="Transparent" BackgroundColor="Transparent" Padding="16">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoToCartCommand}" />
            </Border.GestureRecognizers>
            <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="56" Padding="20,0">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Border BackgroundColor="#33FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                            <Label Text="{Binding CartItems.Count}" TextColor="White" FontAttributes="Bold" FontSize="14"/>
                        </Border>
                        <Label Text="Termék a kosárban" TextColor="White" VerticalOptions="Center" FontSize="14" Opacity="0.9"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="2" Spacing="12" VerticalOptions="Center">
                        <Label Text="{Binding CartTotal, StringFormat='{0} Ft'}" TextColor="White" FontAttributes="Bold" FontSize="18" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="arrow_forward" FontFamily="MaterialIcons" Grid.Column="3" Margin="16,0,0,0"
                      TextColor="White"
                      FontSize="20"
                      VerticalOptions="Center" 
                      HorizontalOptions="Center"/>
                </Grid>
            </Border>
        </Border>

        <!-- Item Detail Bottom Sheet -->
        <bottomsheet:BottomSheet x:Name="ItemBottomSheet" States="Peek" IsOpen="False" HasHandle="True" IsDraggable="True" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <bottomsheet:BottomSheet.Content>
                <bottomsheet:BottomSheetContent>
                    <bottomsheet:BottomSheetContent.ContentTemplate>
                        <DataTemplate>
                            <Grid BackgroundColor="Transparent"
                                  RowDefinitions="Auto, *">
                                <Grid.Behaviors>
                                    <bottomsheet:BottomSheetPeekBehavior />
                                </Grid.Behaviors>

                                <VerticalStackLayout Padding="20" Spacing="16">

                                    <!-- Item Image -->
                                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" HeightRequest="200">
                                        <Image Source="{Binding SelectedItem.PictureUrl}" 
                                               Aspect="AspectFill"/>
                                    </Border>
                                    
                                    <!-- Item Name and Price -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="{Binding SelectedItem.Name}" 
                                               FontSize="24" FontAttributes="Bold" 
                                               TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"
                                               VerticalOptions="Center"/>
                                        <Label Grid.Column="1" 
                                               Text="{Binding SelectedItem.Price, StringFormat='{0} Ft'}" 
                                               FontSize="24" FontAttributes="Bold" 
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                    
                                    <!-- Description -->
                                    <Label Text="{Binding SelectedItem.Description}" 
                                           FontSize="14" 
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}"
                                           LineBreakMode="WordWrap"/>
                                    
                                    <!-- Delivery Time Info -->
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="schedule" FontFamily="MaterialIcons"
                                              TextColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}" 
                                              FontSize="18" VerticalOptions="Center"/>
                                        <Label Text="{Binding SelectedItem.DefaultTimeToDeliver, StringFormat='Elkészítési idő: ~{0} perc'}"
                                               FontSize="14" 
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecLight}, Dark={StaticResource TextSecDark}}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <!-- Separator -->
                                    <BoxView HeightRequest="1" 
                                             BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                             Margin="0,8"/>

                                    <!-- Quantity Selector -->
                                    <Grid ColumnDefinitions="Auto, *, Auto" HeightRequest="50">
                                        <Label Text="Mennyiség" FontSize="16" FontAttributes="Bold" 
                                               TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"
                                               VerticalOptions="Center"/>

                                        <Border Grid.Column="2" 
                                                BackgroundColor="{AppThemeBinding Light={StaticResource BgLight}, Dark={StaticResource BgDark}}"
                                                StrokeShape="RoundRectangle 12" 
                                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                                StrokeThickness="1" Padding="4">
                                            <HorizontalStackLayout Spacing="8">
                                                <!-- Decrease Button -->
                                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" 
                                                        StrokeThickness="0" StrokeShape="RoundRectangle 8" 
                                                        HeightRequest="40" WidthRequest="40">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding DecreaseQuantityCommand}"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="remove" FontFamily="MaterialIcons"
                                                          TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}" 
                                                          FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>

                                                <!-- Quantity Display -->
                                                <Label Text="{Binding Quantity}" 
                                                       FontSize="18" FontAttributes="Bold" 
                                                       TextColor="{AppThemeBinding Light={StaticResource TextMainLight}, Dark={StaticResource TextMainDark}}"
                                                       WidthRequest="40" HorizontalTextAlignment="Center" VerticalOptions="Center"/>

                                                <!-- Increase Button -->
                                                <Border BackgroundColor="{StaticResource Primary}" 
                                                        StrokeThickness="0" StrokeShape="RoundRectangle 8" 
                                                        HeightRequest="40" WidthRequest="40">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding IncreaseQuantityCommand}"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="add" FontFamily="MaterialIcons" TextColor="White" 
                                                          FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>

                                    <!-- Add to Cart Button -->
                                    <Button BackgroundColor="{StaticResource Primary}" 
                                            TextColor="White" 
                                            FontAttributes="Bold" 
                                            FontSize="16"
                                            CornerRadius="12" 
                                            HeightRequest="56"
                                            Text="{Binding TotalPrice, StringFormat='Kosárba - {0} Ft'}"
                                            Command="{Binding AddToCartCommand}"/>
                                    
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </bottomsheet:BottomSheetContent.ContentTemplate>
                </bottomsheet:BottomSheetContent>
            </bottomsheet:BottomSheet.Content>
        </bottomsheet:BottomSheet>


    </Grid>

</ContentPage>
